# ── Postgres local (docker compose) ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=rotulei

# Conexao ADMIN — so para o bootstrap (criar roles). Nunca usada pela API.
# Local: usuario do container. EasyPanel: usuario do servico Postgres.
DATABASE_URL_ADMIN=postgres://postgres:postgres_dev@localhost:5433/rotulei

# Conexao OWNER — dona das tabelas, roda as migrations. Nunca usada pela API.
DATABASE_URL_MIGRATIONS=postgres://rotulei_owner:owner_dev@localhost:5433/rotulei

# Conexao da API — role sem BYPASSRLS. E a unica que o NestJS usa.
DATABASE_URL=postgres://rotulei_app:app_dev@localhost:5433/rotulei

# Senhas usadas pelo bootstrap ao criar as roles (troque em producao!)
ROTULEI_OWNER_PASSWORD=owner_dev
ROTULEI_APP_PASSWORD=app_dev

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-de-no-minimo-32-caracteres
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30

# Cifra de segredos guardados no banco (token do Asaas). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CONFIG_SECRET=troque-por-um-segredo-de-no-minimo-32-caracteres

# Nunca ligue em producao — desativa o rate limiting do cadastro publico.
# So usado pela suite de testes (test/servidor.ts seta isso sozinho).
DESABILITAR_LIMITES=false

# 0 para acesso direto. Em producao, configure o numero exato de proxies
# confiaveis entre o visitante e a API, e bloqueie acesso direto a API.
TRUST_PROXY_HOPS=0
