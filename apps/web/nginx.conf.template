server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # A API fica sob o MESMO dominio do front. Isso elimina CORS e faz a URL da
  # API ser identica em dev (proxy do Vite) e em producao.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Assets com hash no nome podem ser cacheados para sempre.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Fontes .otf self-hosted do cartaz.
  location /fonts/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Fallback do SPA.
  #
  # ARMADILHA JA VIVIDA NO MVP: nunca versione um arquivo estatico num caminho
  # que tambem e uma rota do SPA. A logo tinha sido posta em
  # public/mercadonunes/logo.jpg, o que criava uma PASTA /mercadonunes/ no build;
  # o nginx achava o diretorio real (sem index.html) e respondia 403 antes de
  # chegar neste fallback. Funcionava em dev e quebrava so em producao.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
